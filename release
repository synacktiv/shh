#!/bin/bash -eu

set -o pipefail

readonly VERSION="${1:-$(date +%Y.%-m.%-d)}"
readonly RELEASE_NOTES_FILEPATH="${2:-}"

TAG_MSG="Version ${VERSION}"
if [ -n "${RELEASE_NOTES_FILEPATH}" ]
then
  RELEASE_NOTES="$(<"${RELEASE_NOTES_FILEPATH}")"
  if [ -z "${RELEASE_NOTES//[[:space:]]/}" ]
  then
    echo "Release notes file ${RELEASE_NOTES_FILEPATH@Q} is empty" >&2
    exit 1
  fi
  rumdl check --enable MD033,MD046 "${RELEASE_NOTES_FILEPATH}"
  TAG_MSG+=$'\n\n'"${RELEASE_NOTES}"
fi
readonly TAG_MSG

cd "$(jj root)"

if jj show --stat | tail -n -1 | grep -q '^0 files changed'
then
  jj describe -m "chore: version ${VERSION}"
else
  jj new -m "chore: version ${VERSION}"
fi

cargo set-version "${VERSION}"

cargo upgrade
cargo update

cargo check
cargo test

git cliff --tag "v${VERSION}" --with-tag-message "${TAG_MSG}" | head -n -3 > CHANGELOG.md

jj new
git tag -a --cleanup=verbatim -m "${TAG_MSG}" "v${VERSION}" HEAD
diff <(git cliff | head -n -3) CHANGELOG.md
